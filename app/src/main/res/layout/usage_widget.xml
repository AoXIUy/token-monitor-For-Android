<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:includeFontPadding="false" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/widget_brand" android:textColor="#BAE6FD" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" android:maxLines="1" />
        <LinearLayout android:id="@+id/widget_refresh" android:layout_width="64dp" android:layout_height="match_parent"
            android:background="@drawable/widget_button" android:gravity="center" android:orientation="horizontal"
            android:contentDescription="@string/widget_refresh_description">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/widget_refresh" android:importantForAccessibility="no" />
            <TextView android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
                android:text="@string/widget_refresh" android:textColor="#7DD3FC" android:textSize="11sp" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:includeFontPadding="false" android:id="@+id/widget_period" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:text="@string/widget_today" android:textColor="#94A3B8" android:textSize="11sp" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="40dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:includeFontPadding="false" android:id="@+id/widget_tokens" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/widget_placeholder" android:textColor="#F8FAFC" android:textSize="36sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum" android:maxLines="1"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="24sp" android:autoSizeMaxTextSize="36sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginTop="12dp"
            android:text="@string/widget_tokens_unit" android:textColor="#94A3B8" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:includeFontPadding="false" android:id="@+id/widget_cost_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_cost" android:textColor="#94A3B8" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:includeFontPadding="false" android:id="@+id/widget_cost" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/widget_placeholder" android:textColor="#F1F5F9" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="15sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="0dp">
            <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_cache" android:textColor="#94A3B8" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:includeFontPadding="false" android:id="@+id/widget_cache" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/widget_placeholder" android:textColor="#6EE7B7" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="0dp">
            <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_devices" android:textColor="#94A3B8" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:includeFontPadding="false" android:id="@+id/widget_devices" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/widget_placeholder" android:textColor="#7DD3FC" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:includeFontPadding="false" android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="6dp" android:text="@string/widget_connect" android:textColor="#94A3B8" android:textSize="11sp" android:maxLines="2" />
</LinearLayout>
