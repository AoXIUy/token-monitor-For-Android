<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:includeFontPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_brand"
            android:textColor="#BAE6FD"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:maxLines="1" />
        <LinearLayout
            android:id="@+id/widget_refresh"
            android:layout_width="62dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:contentDescription="@string/widget_refresh_description">
            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/widget_refresh"
                android:importantForAccessibility="no" />
            <TextView
                android:includeFontPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/widget_refresh"
                android:textColor="#7DD3FC"
                android:textSize="11sp"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_period"
            android:includeFontPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_today"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_io_summary"
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_placeholder"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_tokens"
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_placeholder"
            android:textColor="#F8FAFC"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="22sp"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeStepGranularity="1sp" />
        <TextView
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:text="@string/widget_tokens_unit"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_cache_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginBottom="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_sky" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_inset_box"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_cost_label"
                android:includeFontPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_cost"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_cost"
                android:includeFontPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_placeholder"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="0dp"
            android:orientation="vertical">
            <TextView
                android:includeFontPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_cache_short"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_cache"
                android:includeFontPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_placeholder"
                android:textColor="#6EE7B7"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="0dp"
            android:orientation="vertical">
            <TextView
                android:includeFontPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_devices_short"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/widget_devices"
                android:includeFontPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_placeholder"
                android:textColor="#7DD3FC"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_top_tools_label"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_tools_summary"
            android:includeFontPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/widget_placeholder"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_updated"
        android:includeFontPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="5dp"
        android:text="@string/widget_connect"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
