<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="14dp"
    android:paddingVertical="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_brand_quota"
            android:textColor="#BAE6FD"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_quota_headline"
            android:includeFontPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/widget_placeholder"
            android:textColor="#6EE7B7"
            android:textSize="11sp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:ellipsize="end" />
        <LinearLayout
            android:id="@+id/widget_refresh"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:contentDescription="@string/widget_refresh_description">
            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/widget_refresh"
                android:importantForAccessibility="no" />
            <TextView
                android:includeFontPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/widget_refresh"
                android:textColor="#7DD3FC"
                android:textSize="11sp"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_quota_empty"
            android:includeFontPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_quota_empty"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_quota_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_inset_box"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_quota_1_label"
                    android:includeFontPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_placeholder"
                    android:textColor="#F1F5F9"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/widget_quota_1_value"
                    android:includeFontPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/widget_placeholder"
                    android:textColor="#7DD3FC"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1" />
            </LinearLayout>
            <ProgressBar
                android:id="@+id/widget_quota_1_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_sky" />
            <ProgressBar
                android:id="@+id/widget_quota_1_bar_warn"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_progress_warn" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_quota_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_inset_box"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_quota_2_label"
                    android:includeFontPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_placeholder"
                    android:textColor="#F1F5F9"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/widget_quota_2_value"
                    android:includeFontPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/widget_placeholder"
                    android:textColor="#7DD3FC"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1" />
            </LinearLayout>
            <ProgressBar
                android:id="@+id/widget_quota_2_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_sky" />
            <ProgressBar
                android:id="@+id/widget_quota_2_bar_warn"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_progress_warn" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_updated"
        android:includeFontPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:text="@string/widget_connect"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
